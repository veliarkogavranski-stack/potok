// ---- Разбор текста ----

class Chunk {
  final String word; // показываемое слово
  final int orpIndex; // индекс фокусной буквы
  final double delayFactor; // множитель базовой задержки
  Chunk(this.word, this.orpIndex, this.delayFactor);
}

int _orp(String w) => w.isEmpty ? 0 : ((w.length * 0.4).floor()).clamp(0, w.length - 1);

bool _isDigitish(String w) => RegExp(r'^[\d\s.,:;%+\-/()]+$').hasFormat(w) ||
    RegExp(r'\d').hasMatch(w);

bool _isAbbrev(String w) {
  final clean = w.replaceAll(RegExp(r'[.,!?"''()]'), '');
  if (clean.length <= 1) return true;
  if (clean == clean.toUpperCase() && RegExp(r'^[А-ЯЁA-Z]{2,4}\.?').hasMatch(clean)) return true;
  return false;
}

/// Разбивка текста на показываемые чанки с ORP и множителями пауз.
List<Chunk> parseText(String text, int chunkSize) {
  final chunks = <Chunk>[];
  final paragraphs = text.split(RegExp(r'\n\s*\n'));
  for (final para in paragraphs) {
    final words = para.split(RegExp(r'\s+')).where((w) => w.isNotEmpty).toList();
    for (var i = 0; i < words.length; i += chunkSize) {
      final group = words.sublist(i, (i + chunkSize).clamp(0, words.length));
      final joined = group.join(' ');
      var f = 1.0;
      final last = group.last;
      if (RegExp(r'[.!?…]["'')\]]?$').hasMatch(last)) f = 2.5;
      else if (RegExp(r'[,;:—-]["'')\]]?$').hasMatch(last)) f = 1.5;
      final endOfPara = i + chunkSize >= words.length;
      if (endOfPara) f = f < 3 ? 3 : f;
      if (joined.length > 13) f += 1.0;
      if (_isDigitish(joined) || _isAbbrev(joined)) f += 0.8;
      chunks.add(Chunk(joined, _orp(joined), f));
    }
  }
  return chunks;
}

